// ===== DISC FUNCTIONS =====
function discBars(profile, small=false) {
  return ['D','I','S','C'].map(k => {
    const w = profile[k] || 0;
    return `<div class="disc-bar-row">
      <div class="disc-letter" style="background:${discCores[k]}">${k}</div>
      <div class="disc-bar-bg"><div class="disc-bar-fill" style="width:${w}%;background:${discCores[k]}"></div></div>
      <div class="disc-pct" style="color:${discCores[k]}">${w}%</div>
    </div>`;
  }).join('');
}

function discMatchScore(vagaDisc, candDisc) {
  // Calcula similaridade ponderada
  const diff = ['D','I','S','C'].reduce((acc,k) => acc + Math.abs((vagaDisc[k]||0)-(candDisc[k]||0)), 0);
  return Math.max(0, Math.round(100 - diff * 0.8));
}

function discMatchColor(score) {
  if(score >= 80) return 'var(--green)';
  if(score >= 60) return '#f5c518';
  return 'var(--salmon)';
}

function discMatchLabel(score) {
  if(score >= 80) return 'Ótimo match';
  if(score >= 60) return 'Match parcial';
  return 'Baixo match';
}

function renderDiscVagaModal(vagaId) {
  const disc = discVagas[vagaId];
  if(!disc) return;
  const el = document.getElementById('m-disc-vaga');
  if(!el) return;
  el.innerHTML = `
    <div style="display:flex;gap:14px;align-items:flex-start">
      <div style="flex:1">${discBars(disc)}</div>
      <div style="text-align:center;flex-shrink:0">
        <div style="width:50px;height:50px;border-radius:50%;background:${discCores[disc.prim]};display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#fff;margin:0 auto 6px">${disc.prim}</div>
        <div style="font-size:9px;color:var(--gray);font-weight:600">${discNomes[disc.prim]}</div>
        <div style="font-size:10px;color:var(--gray)">primário</div>
      </div>
    </div>
    <div style="margin-top:10px;font-size:11px;color:var(--gray);line-height:1.6">${disc.desc}</div>
  `;
}

function renderCandidatosComDisc(vaga) {
  const vagaDisc = discVagas[vaga.id];
  return vaga.candidatos.map(c => {
    const cd = discCandidatos[c.nome] || {D:25,I:25,S:25,C:25,prim:'S'};
    const match = vagaDisc ? discMatchScore(vagaDisc, cd) : null;
    const mc = match ? discMatchColor(match) : 'var(--gray)';
    return `<div class="cand-row2">
      <div class="cr2-av" style="background:${c.cor}">${c.nome.split(' ').map(n=>n[0]).join('').slice(0,2)}</div>
      <div style="flex:1">
        <div class="cr2-name">${c.nome}</div>
        <div class="cr2-stage">${c.etapa}</div>
        <div style="margin-top:4px;display:flex;gap:4px">
          ${['D','I','S','C'].map(k=>`<span class="disc-tag" style="background:${discCores[k]}22;color:${discCores[k]}">${k} ${cd[k]}%</span>`).join('')}
        </div>
        <div style="font-size:10px;color:var(--gray);margin-top:3px">${cd.desc}</div>
      </div>
      <div style="text-align:center;flex-shrink:0;margin-left:8px">
        ${match !== null ? `
          <div style="width:46px;height:46px;border-radius:50%;border:3px solid ${mc};display:flex;flex-direction:column;align-items:center;justify-content:center">
            <div style="font-size:13px;font-weight:800;color:${mc};line-height:1">${match}%</div>
            <div style="font-size:8px;color:var(--gray)">match</div>
          </div>
          <div style="font-size:9px;color:${mc};font-weight:700;margin-top:3px">${discMatchLabel(match)}</div>
        ` : `<div class="cr2-score" style="color:var(--green)">${c.score}</div>`}
      </div>
    </div>`;
  }).join('') || '<div style="font-size:11px;color:var(--gray);padding:8px 0">Nenhum candidato vinculado ainda.</div>';
}

function renderDiscView() {
  const sel = document.getElementById('disc-vaga-sel');
  const idx = sel ? parseInt(sel.value) : 0;
  const vaga = vagas[idx];
  if(!vaga) return;
  const disc = discVagas[vaga.id];
  if(!disc) return;

  // Perfil ideal da vaga
  const barsEl = document.getElementById('disc-vaga-bars');
  if(barsEl) barsEl.innerHTML = discBars(disc);
  const descEl = document.getElementById('disc-vaga-desc');
  if(descEl) descEl.innerHTML = `<strong style="color:${discCores[disc.prim]}">${discEmojis[disc.prim]} Perfil primário: ${discNomes[disc.prim]}</strong><br>${disc.desc}`;

  // Matches dos candidatos
  const matchEl = document.getElementById('disc-matches');
  if(matchEl) {
    if(!vaga.candidatos.length) { matchEl.innerHTML='<div style="font-size:12px;color:var(--gray)">Nenhum candidato vinculado.</div>'; }
    else {
      matchEl.innerHTML = vaga.candidatos.map(c => {
        const cd = discCandidatos[c.nome] || {D:25,I:25,S:25,C:25,prim:'S'};
        const match = discMatchScore(disc, cd);
        const mc = discMatchColor(match);
        return `<div class="match-card">
          <div class="disc-match-ring" style="border-color:${mc}">
            <div class="disc-match-pct" style="color:${mc}">${match}%</div>
            <div class="disc-match-lbl">match</div>
          </div>
          <div class="match-info">
            <div class="match-name">${c.nome}</div>
            <div class="match-sub">${c.etapa} · DISC primário: <strong style="color:${discCores[cd.prim]}">${cd.prim} – ${discNomes[cd.prim]}</strong></div>
            <div style="font-size:10px;margin-top:4px">${['D','I','S','C'].map(k=>`<span class="disc-tag" style="background:${discCores[k]}22;color:${discCores[k]}">${k}${cd[k]}%</span>`).join(' ')}</div>
          </div>
          <div style="font-size:10px;font-weight:700;color:${mc}">${discMatchLabel(match)}</div>
        </div>`;
      }).join('');
    }
  }

  // Todos os candidatos
  const allEl = document.getElementById('disc-all-candidates');
  if(allEl) {
    const all = vagas.flatMap(v => v.candidatos.map(c=>({...c,vaga:v})));
    allEl.innerHTML = all.map(c => {
      const cd = discCandidatos[c.nome] || {D:25,I:25,S:25,C:25,prim:'S',desc:''};
      return `<div class="chart-card" style="padding:14px">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
          <div style="width:34px;height:34px;border-radius:50%;background:${c.cor};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff">${c.nome.split(' ').map(n=>n[0]).join('').slice(0,2)}</div>
          <div>
            <div style="font-size:12px;font-weight:700">${c.nome}</div>
            <div style="font-size:10px;color:var(--gray)">${c.vaga.titulo}</div>
          </div>
          <div style="margin-left:auto;width:32px;height:32px;border-radius:50%;background:${discCores[cd.prim]};display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#fff">${cd.prim}</div>
        </div>
        ${discBars(cd)}
        <div style="font-size:10px;color:var(--gray);margin-top:8px">${cd.desc}</div>
      </div>`;
    }).join('');
  }
}

// DISC Gestor form
const discState = {d1:'frequente',i1:'as-vezes',s1:'frequente',c1:'frequente',r1:'misto',l1:'colabora'};
function discSelect(btn, key, val) {
  discState[key] = val;
  btn.closest('.disc-q-options').querySelectorAll('.disc-q-opt').forEach(b=>b.classList.remove('sel'));
  btn.classList.add('sel');
  updateDiscPreview();
}
function updateDiscPreview() {
  const weights = {nunca:5,raramente:10,'as-vezes':20,frequente:35,sempre:45};
  const D = (weights[discState.d1]||20) + (discState.r1==='intenso'?10:0) + (discState.l1==='sim-formal'?10:0);
  const I = (weights[discState.i1]||20) + (discState.r1==='intenso'?5:0) + (discState.l1==='colabora'?8:0);
  const S = (weights[discState.s1]||20) + (discState.r1==='estavel'?10:0) + (discState.l1==='colabora'?5:0);
  const C = (weights[discState.c1]||20) + (discState.r1==='estavel'?5:0);
  const tot = D+I+S+C;
  const p = {D:Math.round(D/tot*100),I:Math.round(I/tot*100),S:Math.round(S/tot*100),C:Math.round(C/tot*100)};
  const prim = ['D','I','S','C'].reduce((a,b)=>p[a]>p[b]?a:b);
  const barsEl = document.getElementById('disc-preview-bars');
  const tagEl = document.getElementById('disc-preview-tag');
  if(barsEl) barsEl.innerHTML = ['D','I','S','C'].map(k=>`
    <div class="disc-bar-row">
      <div class="disc-letter" style="background:${discCores[k]}">${k}</div>
      <div class="disc-bar-bg" style="background:rgba(255,255,255,0.1)"><div class="disc-bar-fill" style="width:${p[k]}%;background:${discCores[k]}"></div></div>
      <div class="disc-pct" style="color:${discCores[k]}">${p[k]}%</div>
    </div>`).join('');
  if(tagEl) tagEl.innerHTML = `<div style="width:56px;height:56px;border-radius:50%;background:${discCores[prim]};display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;color:#fff;margin:0 auto 6px">${prim}</div><div style="font-size:10px;color:var(--gray)">${discNomes[prim]}</div>`;
}

