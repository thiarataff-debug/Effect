  document.getElementById('funnel-chart').innerHTML = fd.map(f=>`
    <div class="funnel-row">
      <div class="f-label">${f.l}</div>
      <div class="f-wrap"><div class="f-bar" style="width:${(f.n/89*100).toFixed(0)}%;background:${f.c}">${f.n}</div></div>
      <div class="f-num">${f.n}</div>
    </div>`).join('');

  // Donut
