<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Effect — Painel Interno</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#1a2a4a;--bg:#f5f7fa;--muted:#a1a1aa;--green:#8ed1b2;--blue:#1fa5ff;--pink:#f4afa1;--text:#2a2a2b;--white:#fff;--border:#e5e7eb}
body{font-family:'Montserrat',sans-serif;background:var(--bg);color:var(--text);height:100vh;display:flex;overflow:hidden}

/* LOGIN */
#login{position:fixed;inset:0;background:var(--navy);display:flex;align-items:center;justify-content:center;z-index:200}
#login.hidden{display:none}
.login-box{background:#fff;border-radius:16px;padding:48px 40px;width:340px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.login-logo{font-size:22px;font-weight:800;color:var(--navy);margin-bottom:4px}.login-logo span{color:var(--green)}
.login-sub{font-size:12px;color:var(--muted);margin-bottom:28px}
.login-box input{width:100%;padding:12px 16px;border:2px solid var(--bg);border-radius:10px;font-family:'Montserrat',sans-serif;font-size:14px;outline:none;margin-bottom:14px}
.login-box input:focus{border-color:var(--blue)}
.login-box button{width:100%;padding:12px;background:var(--navy);color:#fff;border:none;border-radius:10px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:14px;cursor:pointer}
.login-box button:hover{background:var(--blue)}
.login-err{color:var(--pink);font-size:12px;margin-top:10px;display:none}

/* SIDEBAR */
.sidebar{width:220px;background:var(--navy);display:flex;flex-direction:column;flex-shrink:0;padding:0}
.sidebar-logo{padding:20px 20px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
.sidebar-logo-text{font-weight:800;font-size:14px;color:#fff}.sidebar-logo-text span{color:var(--green)}
.sidebar-sub{font-size:10px;color:rgba(255,255,255,.35);margin-top:2px}
.nav-section{padding:16px 12px 8px;font-size:9px;font-weight:700;color:rgba(255,255,255,.25);text-transform:uppercase;letter-spacing:1px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 16px;border-radius:8px;margin:2px 8px;cursor:pointer;transition:all .15s;color:rgba(255,255,255,.6);font-size:12px;font-weight:600;text-decoration:none}
.nav-item:hover{background:rgba(255,255,255,.08);color:#fff}
.nav-item.active{background:rgba(31,165,255,.2);color:var(--blue)}
.nav-item .icon{font-size:15px;width:20px;text-align:center;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--blue);color:#fff;border-radius:8px;padding:1px 7px;font-size:10px;font-weight:700}
.nav-badge.green{background:var(--green);color:var(--navy)}
.sidebar-bottom{margin-top:auto;padding:16px;border-top:1px solid rgba(255,255,255,.08)}
.sidebar-user{display:flex;align-items:center;gap:8px}
.user-avatar{width:32px;height:32px;border-radius:50%;background:var(--green);color:var(--navy);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0}
.user-name{font-size:11px;font-weight:700;color:#fff}
.user-role{font-size:10px;color:rgba(255,255,255,.35)}
.dot-live{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite;margin-left:auto}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{background:#fff;padding:12px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.topbar-title{font-weight:800;font-size:15px;color:var(--navy)}
.topbar-right{display:flex;align-items:center;gap:10px}
.update-time{font-size:11px;color:var(--muted)}
.refresh-btn{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:6px 12px;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;cursor:pointer}
.refresh-btn:hover{background:var(--border)}

.page{flex:1;overflow-y:auto;padding:24px;display:none}
.page.active{display:block}

/* STATS */
.stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:24px}
.stat-card{background:#fff;border-radius:12px;padding:16px;box-shadow:0 1px 4px rgba(0,0,0,.05);border-left:4px solid var(--border)}
.stat-card.blue{border-left-color:var(--blue)}
.stat-card.green{border-left-color:var(--green)}
.stat-card.yellow{border-left-color:#f59e0b}
.stat-card.red{border-left-color:var(--pink)}
.stat-num{font-size:28px;font-weight:800;color:var(--navy);line-height:1}
.stat-label{font-size:10px;color:var(--muted);margin-top:4px;text-transform:uppercase;letter-spacing:.5px}

/* CARDS CANDIDATOS */
.filter-bar{background:#fff;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.filter-input{padding:7px 12px;border:1.5px solid var(--border);border-radius:8px;font-family:'Montserrat',sans-serif;font-size:12px;outline:none;min-width:200px}
.filter-input:focus{border-color:var(--blue)}
.fchip{padding:5px 12px;border-radius:20px;border:1.5px solid var(--border);font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;cursor:pointer;background:#fff;transition:all .15s}
.fchip.active{background:var(--navy);color:#fff;border-color:var(--navy)}

.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:14px}
.cand-card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06);border:1.5px solid var(--border);display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s}
.cand-card:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.09)}
.card-top{padding:14px 16px 10px;display:flex;align-items:flex-start;gap:10px;border-bottom:1px solid #f3f4f6}
.card-top.excelente{background:linear-gradient(135deg,#fff8e7,#fff 60%);border-left:4px solid #f59e0b}
.card-top.bom{background:linear-gradient(135deg,#edfaf4,#fff 60%);border-left:4px solid var(--green)}
.card-top.regular{background:linear-gradient(135deg,#fffde7,#fff 60%);border-left:4px solid #facc15}
.card-top.reprovado{background:linear-gradient(135deg,#fff0f0,#fff 60%);border-left:4px solid var(--pink);opacity:.75}
.card-top.default{background:#fff;border-left:4px solid var(--border)}
.cav{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;color:#fff;flex-shrink:0}
.cav.excelente{background:#f59e0b}.cav.bom{background:var(--green);color:var(--navy)}.cav.regular{background:#facc15;color:var(--navy)}.cav.reprovado{background:var(--pink)}.cav.default{background:var(--navy)}
.cand-hinfo{flex:1;min-width:0}
.cand-name{font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px}
.cand-sub{font-size:10px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.score-c{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;flex-shrink:0}
.sc-alto{background:#dcfce7;color:#15803d}.sc-medio{background:#fef9c3;color:#a16207}.sc-baixo{background:#fee2e2;color:#dc2626}.sc-zero{background:#f3f4f6;color:var(--muted)}
.card-body{padding:12px 16px;flex:1;display:flex;flex-direction:column;gap:8px}
.vaga-tag{display:inline-flex;align-items:center;gap:4px;background:#eff6ff;color:#1d4ed8;border-radius:6px;padding:3px 9px;font-size:10px;font-weight:700;align-self:flex-start;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cchips{display:flex;flex-wrap:wrap;gap:4px}
.cc{padding:2px 7px;border-radius:8px;font-size:9px;font-weight:700}
.cc-green{background:#dcfce7;color:#16a34a}.cc-blue{background:#dbeafe;color:#1d4ed8}.cc-red{background:#fee2e2;color:#dc2626}.cc-gray{background:#f3f4f6;color:var(--muted)}.cc-navy{background:#e8edf5;color:var(--navy)}.cc-yellow{background:#fef9c3;color:#a16207}.cc-pink{background:#fde8e4;color:#b04a38}
.pfortes{font-size:10.5px;color:#555;line-height:1.5;background:#f8fafc;border-radius:6px;padding:6px 10px;border-left:3px solid var(--green)}
.card-footer{padding:8px 16px;border-top:1px solid #f3f4f6;display:flex;align-items:center;justify-content:space-between;background:#fafbfc;gap:6px}
.card-date{font-size:9px;color:var(--muted)}
.card-actions{display:flex;gap:5px}
.action-btn{padding:4px 10px;border-radius:6px;border:none;font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;cursor:pointer;transition:all .15s}
.action-btn.aprovar{background:#dcfce7;color:#16a34a}.action-btn.aprovar:hover{background:#16a34a;color:#fff}
.action-btn.reprovar{background:#fee2e2;color:#dc2626}.action-btn.reprovar:hover{background:#dc2626;color:#fff}
.action-btn.wa{background:#25D366;color:#fff}
.cls-badge{padding:2px 7px;border-radius:8px;font-size:9px;font-weight:700}
.cls-excelente{background:#fef3c7;color:#92400e}.cls-bom{background:#dcfce7;color:#16a34a}.cls-regular{background:#fef9c3;color:#a16207}.cls-reprovado{background:#fee2e2;color:#dc2626}.cls-default{background:#f3f4f6;color:var(--muted)}

/* MODAL STATUS */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:150;display:none;align-items:center;justify-content:center}
.modal-overlay.show{display:flex}
.modal{background:#fff;border-radius:14px;padding:28px;width:360px;box-shadow:0 20px 60px rgba(0,0,0,.2)}
.modal h3{font-weight:700;font-size:16px;color:var(--navy);margin-bottom:16px}
.modal select,.modal textarea{width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:8px;font-family:'Montserrat',sans-serif;font-size:13px;outline:none;margin-bottom:12px}
.modal select:focus,.modal textarea:focus{border-color:var(--blue)}
.modal textarea{resize:none;min-height:80px}
.modal-btns{display:flex;gap:8px;justify-content:flex-end}
.modal-cancel{padding:9px 18px;border-radius:8px;border:2px solid var(--border);background:#fff;font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;cursor:pointer;color:var(--muted)}
.modal-save{padding:9px 18px;border-radius:8px;border:none;background:var(--navy);color:#fff;font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;cursor:pointer}
.modal-save:hover{background:var(--blue)}

/* VAGAS */
.vagas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.vaga-card{background:#fff;border-radius:12px;padding:16px;box-shadow:0 1px 4px rgba(0,0,0,.05);border-left:4px solid var(--blue);display:flex;flex-direction:column;gap:8px}
.vaga-card.encerrada{border-left-color:var(--muted);opacity:.65}
.vaga-titulo{font-weight:700;font-size:14px;color:var(--navy)}
.vaga-cliente{font-size:11px;color:var(--blue);font-weight:600}
.vaga-rows{display:flex;flex-direction:column;gap:4px}
.vaga-row{display:flex;gap:6px;font-size:11.5px;color:#555;align-items:flex-start}
.vaga-icon{flex-shrink:0;color:var(--muted);width:14px;text-align:center}
.vaga-footer{display:flex;gap:5px;flex-wrap:wrap;margin-top:4px}

/* INBOX */
.inbox-wrap{display:flex;height:calc(100vh - 105px);gap:0;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.inbox-sidebar{width:280px;border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.inbox-sidebar-top{padding:12px 14px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:8px}
.inbox-search{display:flex;align-items:center;gap:6px;background:var(--bg);border-radius:8px;padding:6px 10px}
.inbox-search input{border:none;background:transparent;font-family:'Montserrat',sans-serif;font-size:12px;outline:none;flex:1}
.inbox-ftabs{display:flex;gap:3px;padding:6px 12px;border-bottom:1px solid var(--border);flex-shrink:0}
.iftab{padding:3px 9px;border-radius:10px;border:none;font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;cursor:pointer;background:var(--bg);color:var(--muted)}
.iftab.active{background:var(--navy);color:#fff}
.inbox-list{flex:1;overflow-y:auto}
.iconv{padding:10px 14px;border-bottom:1px solid #f3f4f6;cursor:pointer;display:flex;gap:8px;align-items:flex-start;transition:background .1s}
.iconv:hover{background:#f8fafc}
.iconv.active{background:#eff6ff;border-left:3px solid var(--blue)}
.iconv.manual{border-left:3px solid var(--pink)}
.iav{width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0}
.iconv-info{flex:1;min-width:0}
.iconv-name{font-weight:700;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.iconv-preview{font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.iconv-chips{display:flex;gap:3px;margin-top:4px;flex-wrap:wrap}
.idot{width:6px;height:6px;border-radius:50%;margin-top:5px;flex-shrink:0}
.idot.lia{background:var(--green)}.idot.manual{background:var(--pink)}
.inbox-chat{flex:1;display:flex;flex-direction:column;background:#f0f2f5;overflow:hidden}
.ichat-empty{flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;color:var(--muted)}
.ichat-header{background:#fff;padding:12px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0}
.ichat-av{width:40px;height:40px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0}
.ichat-info{flex:1}
.ichat-name{font-weight:700;font-size:14px}
.ichat-meta{font-size:11px;color:var(--muted);margin-top:2px}
.mode-toggle{display:flex;gap:5px}
.mbtn{padding:5px 12px;border-radius:7px;border:none;font-family:'Montserrat',sans-serif;font-size:10px;font-weight:700;cursor:pointer;background:var(--bg);color:var(--muted)}
.mbtn.lia-on{background:var(--green);color:var(--navy)}.mbtn.manual-on{background:var(--pink);color:#fff}
.ichat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:4px}
.date-sep{text-align:center;margin:8px 0}.date-sep span{background:#e5e7eb;color:var(--muted);font-size:9px;font-weight:600;padding:2px 10px;border-radius:8px}
.msg-group{display:flex;flex-direction:column;margin-bottom:5px}
.msg-group.candidato{align-items:flex-start}.msg-group.lia{align-items:flex-end}
.msg-sender{font-size:9px;font-weight:700;color:var(--muted);margin-bottom:2px;padding:0 4px;text-transform:uppercase;letter-spacing:.5px}
.mbubble{max-width:70%;padding:9px 12px;border-radius:14px;font-size:12px;line-height:1.5;word-break:break-word;white-space:pre-wrap}
.mbubble.candidato{background:#fff;border-bottom-left-radius:3px;box-shadow:0 1px 3px rgba(0,0,0,.07)}
.mbubble.lia{background:var(--navy);color:#fff;border-bottom-right-radius:3px}
.msg-time{font-size:9px;color:var(--muted);padding:0 4px;margin-top:2px}
.manual-warn{background:#fff8f0;border-top:1px solid #fde8e4;padding:6px 18px;font-size:10px;color:#b45309;font-weight:600;flex-shrink:0;display:none}
.manual-warn.show{display:block}
.ichat-input{background:#fff;padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px;align-items:flex-end;flex-shrink:0}
.ichat-input textarea{flex:1;padding:9px 14px;border:2px solid var(--bg);border-radius:10px;font-family:'Montserrat',sans-serif;font-size:12px;resize:none;outline:none;max-height:100px;min-height:38px;line-height:1.5}
.ichat-input textarea:focus{border-color:var(--blue)}
.isend{padding:9px 16px;background:var(--navy);color:#fff;border:none;border-radius:10px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:12px;cursor:pointer;white-space:nowrap}
.isend:hover{background:var(--blue)}.isend:disabled{background:var(--muted)}

/* DASHBOARD */
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.dash-box{background:#fff;border-radius:12px;padding:18px;box-shadow:0 1px 4px rgba(0,0,0,.05)}
.dash-box-title{font-weight:700;font-size:12px;color:var(--navy);margin-bottom:14px;text-transform:uppercase;letter-spacing:.5px;padding-bottom:8px;border-bottom:2px solid var(--blue)}
.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:7px;font-size:11px}
.bar-label{width:140px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-track{flex:1;background:#f3f4f6;border-radius:3px;height:12px;overflow:hidden}
.bar-fill{height:100%;border-radius:3px;transition:width .6s}
.bar-val{width:28px;text-align:right;font-weight:700;color:var(--navy)}

/* LOADING */
.loading{display:flex;align-items:center;justify-content:center;padding:60px;color:var(--muted);font-size:13px;gap:10px}
.spinner{width:20px;height:20px;border:2px solid #e5e7eb;border-top-color:var(--blue);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.empty{padding:40px;text-align:center;color:var(--muted);font-size:13px}

/* TOAST */
.toast{position:fixed;bottom:18px;right:18px;background:#2a2a2b;color:#fff;padding:10px 18px;border-radius:10px;font-size:12px;font-weight:600;z-index:300;opacity:0;transform:translateY(10px);transition:all .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateY(0)}
.toast.success{background:var(--green);color:var(--navy)}.toast.error{background:var(--pink);color:#fff}

::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:4px}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login">
  <div class="login-box">
    <div class="login-logo">Effect <span>Pessoas</span></div>
    <div class="login-sub">Painel Interno — Acesso restrito</div>
    <input type="password" id="pwd" placeholder="Senha de acesso" onkeydown="if(event.key==='Enter')entrar()">
    <button onclick="entrar()">Entrar</button>
    <div class="login-err" id="login-err">Senha incorreta.</div>
  </div>
</div>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="sidebar-logo">
    <div class="sidebar-logo-text">Effect <span>Pessoas</span></div>
    <div class="sidebar-sub">Painel Interno</div>
  </div>
  <div class="nav-section">Principal</div>
  <a class="nav-item active" onclick="irPara('dashboard',this)"><span class="icon">📊</span>Dashboard</a>
  <a class="nav-item" onclick="irPara('inbox',this)"><span class="icon">💬</span>Inbox Lia <span class="nav-badge green" id="badge-inbox">0</span></a>
  <div class="nav-section">Banco de Dados</div>
  <a class="nav-item" onclick="irPara('candidatos',this)"><span class="icon">👥</span>Candidatos <span class="nav-badge" id="badge-cand">0</span></a>
  <a class="nav-item" onclick="irPara('vagas',this)"><span class="icon">📋</span>Vagas <span class="nav-badge" id="badge-vagas">0</span></a>
  <div class="nav-section">Ferramentas</div>
  <a class="nav-item" href="/cliente" target="_blank"><span class="icon">🔗</span>Link do Cliente</a>
  <a class="nav-item" href="/sheets" target="_blank"><span class="icon">📑</span>Sheets Viewer</a>
  <div class="sidebar-bottom">
    <div class="sidebar-user">
      <div class="user-avatar">T</div>
      <div><div class="user-name">Thiara</div><div class="user-role">Effect Pessoas</div></div>
      <div class="dot-live"></div>
    </div>
  </div>
</div>

<!-- MAIN -->
<div class="main">
  <div class="topbar">
    <div class="topbar-title" id="topbar-title">Dashboard</div>
    <div class="topbar-right">
      <span class="update-time" id="update-time"></span>
      <button class="refresh-btn" onclick="carregarTudo()">⟳ Atualizar</button>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div class="page active" id="page-dashboard">
    <div class="stats-row" id="dash-stats"></div>
    <div class="dash-grid" id="dash-charts"></div>
  </div>

  <!-- INBOX -->
  <div class="page" id="page-inbox">
    <div class="inbox-wrap">
      <div class="inbox-sidebar">
        <div class="inbox-sidebar-top">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span style="font-weight:700;font-size:13px;color:var(--navy)">Conversas</span>
            <span class="cc cc-blue" id="inbox-count">0</span>
          </div>
          <div class="inbox-search">
            <span style="color:var(--muted);font-size:12px">🔍</span>
            <input type="text" placeholder="Buscar..." oninput="filtrarInbox(this.value)">
          </div>
        </div>
        <div class="inbox-ftabs">
          <button class="iftab active" onclick="setInboxTab(this,'todas')">Todas</button>
          <button class="iftab" onclick="setInboxTab(this,'manual')">✍️</button>
          <button class="iftab" onclick="setInboxTab(this,'pausado')">⏸</button>
        </div>
        <div class="inbox-list" id="inbox-list"></div>
      </div>
      <div class="inbox-chat" id="inbox-chat">
        <div class="ichat-empty" id="ichat-empty">
          <div style="font-size:40px">💬</div>
          <div style="font-size:13px;font-weight:600">Selecione uma conversa</div>
        </div>
        <div id="ichat-active" style="display:none;flex-direction:column;flex:1;overflow:hidden">
          <div class="ichat-header">
            <div class="ichat-av" id="ichat-av">?</div>
            <div class="ichat-info">
              <div class="ichat-name" id="ichat-name">—</div>
              <div class="ichat-meta" id="ichat-meta">—</div>
            </div>
            <div class="mode-toggle">
              <button class="mbtn" id="mbtn-lia" onclick="setModo('lia')">🤖 Lia</button>
              <button class="mbtn" id="mbtn-manual" onclick="setModo('manual')">✍️ Manual</button>
            </div>
          </div>
          <div class="manual-warn" id="manual-warn">✍️ Modo manual — você está respondendo como Lia.</div>
          <div class="ichat-messages" id="ichat-msgs"></div>
          <div class="ichat-input">
            <textarea id="ichat-txt" placeholder="A Lia responde automaticamente..." rows="1"
              oninput="autoResize(this)"
              onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();enviarMsg()}"></textarea>
            <button class="isend" id="isend" onclick="enviarMsg()">Enviar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CANDIDATOS -->
  <div class="page" id="page-candidatos">
    <div class="filter-bar">
      <input class="filter-input" placeholder="🔍 Nome, telefone ou vaga..." oninput="filtrarCandidatos(this.value)" id="cand-search">
      <button class="fchip active" onclick="setFiltroClass(this,'')">Todas</button>
      <button class="fchip" onclick="setFiltroClass(this,'Excelente')">⭐ Excelente</button>
      <button class="fchip" onclick="setFiltroClass(this,'Bom')">✅ Bom</button>
      <button class="fchip" onclick="setFiltroClass(this,'Regular')">Regular</button>
      <button class="fchip" onclick="setFiltroClass(this,'Reprovado')">Reprovado</button>
      <button class="fchip" id="fchip-int" onclick="toggleFiltroInt()">✓ Interessados</button>
    </div>
    <div class="cards-grid" id="cand-grid"></div>
  </div>

  <!-- VAGAS -->
  <div class="page" id="page-vagas">
    <div class="filter-bar">
      <input class="filter-input" placeholder="🔍 Cargo, cliente ou cidade..." oninput="filtrarVagas(this.value)" id="vaga-search">
      <button class="fchip active" onclick="setFiltroVaga(this,'todas')">Todas</button>
      <button class="fchip" onclick="setFiltroVaga(this,'ativas')">🟢 Abertas</button>
      <button class="fchip" onclick="setFiltroVaga(this,'encerradas')">Encerradas</button>
    </div>
    <div class="vagas-grid" id="vagas-grid"></div>
  </div>
</div>

<!-- MODAL STATUS -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <h3 id="modal-title">Atualizar candidato</h3>
    <select id="modal-status">
      <option value="">Manter status atual</option>
      <option value="Interessado">✓ Interessado</option>
      <option value="Analisado pela Lia">🤖 Analisado pela Lia</option>
      <option value="Em processo">Em processo</option>
      <option value="Entrevista agendada">Entrevista agendada</option>
      <option value="Aprovado">✅ Aprovado</option>
      <option value="Reprovado">✗ Reprovado</option>
    </select>
    <textarea id="modal-obs" placeholder="Adicionar observação (opcional)..."></textarea>
    <div class="modal-btns">
      <button class="modal-cancel" onclick="fecharModal()">Cancelar</button>
      <button class="modal-save" onclick="salvarStatus()">Salvar</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const SENHA = "effect2026";
const API_BASE = window.location.origin;

let candidatos = [];
let vagas = [];
let sessoes = {};
let filtroClass = '';
let filtroInt = false;
let filtroVagaTab = 'todas';
let inboxTab = 'todas';
let inboxBusca = '';
let candBusca = '';
let vagaBusca = '';
let sessaoAtual = null;
let modalTelefone = null;

// LOGIN
function entrar() {
  if (document.getElementById('pwd').value === SENHA) {
    document.getElementById('login').classList.add('hidden');
    carregarTudo();
    setInterval(carregarTudo, 30000);
  } else {
    document.getElementById('login-err').style.display = 'block';
  }
}

// NAVEGAÇÃO
function irPara(pagina, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById(`page-${pagina}`).classList.add('active');
  if (el) el.classList.add('active');
  const titulos = {dashboard:'Dashboard',inbox:'Inbox Lia',candidatos:'Candidatos',vagas:'Vagas'};
  document.getElementById('topbar-title').textContent = titulos[pagina] || pagina;
  if (pagina === 'candidatos') renderCandidatos();
  if (pagina === 'vagas') renderVagas();
  if (pagina === 'inbox') renderInboxLista();
  if (pagina === 'dashboard') renderDashboard();
}

// CARREGAR DADOS
async function carregarTudo() {
  try {
    const [rC, rV, rS] = await Promise.all([
      fetch(`${API_BASE}/sheets/candidatos`).then(r=>r.json()).catch(()=>({candidatos:[]})),
      fetch(`${API_BASE}/sheets/vagas`).then(r=>r.json()).catch(()=>({vagas:[]})),
      fetch(`${API_BASE}/inbox/sessoes`).then(r=>r.json()).catch(()=>({sessoes:{}}))
    ]);
    candidatos = rC.candidatos || [];
    vagas = rV.vagas || [];
    sessoes = rS.sessoes || {};
    document.getElementById('update-time').textContent = `Atualizado: ${new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}`;
    document.getElementById('badge-cand').textContent = candidatos.length;
    document.getElementById('badge-vagas').textContent = vagas.filter(v=>!['inativa','fechada','cancelada','encerrada'].includes((v.status||'').toLowerCase())).length;
    document.getElementById('badge-inbox').textContent = Object.keys(sessoes).length;
    document.getElementById('inbox-count').textContent = Object.keys(sessoes).length;
    const pageAtiva = document.querySelector('.page.active')?.id?.replace('page-','');
    if (pageAtiva === 'candidatos') renderCandidatos();
    if (pageAtiva === 'vagas') renderVagas();
    if (pageAtiva === 'inbox') { renderInboxLista(); if(sessaoAtual) renderMsgs(sessoes[sessaoAtual]); }
    if (pageAtiva === 'dashboard') renderDashboard();
  } catch(e) { console.error(e); }
}

// DASHBOARD
function renderDashboard() {
  const total = candidatos.length;
  const excelentes = candidatos.filter(c=>c['Classificação']==='Excelente').length;
  const bons = candidatos.filter(c=>c['Classificação']==='Bom').length;
  const regulares = candidatos.filter(c=>c['Classificação']==='Regular').length;
  const reprovados = candidatos.filter(c=>c['Classificação']==='Reprovado').length;
  const interessados = candidatos.filter(c=>c['Status']==='Interessado').length;
  const vagasAtivas = vagas.filter(v=>!['inativa','fechada','cancelada','encerrada'].includes((v.status||'').toLowerCase())).length;
  const conversas = Object.keys(sessoes).length;

  document.getElementById('dash-stats').innerHTML = `
    <div class="stat-card blue"><div class="stat-num">${total}</div><div class="stat-label">Candidatos</div></div>
    <div class="stat-card yellow"><div class="stat-num" style="color:#f59e0b">${excelentes}</div><div class="stat-label">Excelentes</div></div>
    <div class="stat-card green"><div class="stat-num" style="color:#16a34a">${interessados}</div><div class="stat-label">Interessados</div></div>
    <div class="stat-card"><div class="stat-num">${vagasAtivas}</div><div class="stat-label">Vagas Ativas</div></div>
    <div class="stat-card"><div class="stat-num" style="color:var(--blue)">${conversas}</div><div class="stat-label">Conversas Lia</div></div>
    <div class="stat-card red"><div class="stat-num" style="color:#dc2626">${reprovados}</div><div class="stat-label">Reprovados</div></div>
  `;

  const porVaga = {};
  candidatos.forEach(c => {
    const v = c['Vaga de Interesse']||'Sem vaga';
    if (!porVaga[v]) porVaga[v] = 0;
    porVaga[v]++;
  });
  const vagasRank = Object.entries(porVaga).sort((a,b)=>b[1]-a[1]);
  const maxV = Math.max(...vagasRank.map(x=>x[1]),1);

  const porCidade = {};
  candidatos.forEach(c => {
    const ci = (c['Cidade / Estado']||'Não informada').split('/')[0].trim();
    porCidade[ci] = (porCidade[ci]||0)+1;
  });
  const cidades = Object.entries(porCidade).sort((a,b)=>b[1]-a[1]).slice(0,8);
  const maxC = Math.max(...cidades.map(x=>x[1]),1);

  document.getElementById('dash-charts').innerHTML = `
    <div class="dash-box" style="grid-column:1/-1">
      <div class="dash-box-title">Classificação dos Candidatos</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        ${[['Excelente','#f59e0b',excelentes],['Bom','#8ed1b2',bons],['Regular','#facc15',regulares],['Reprovado','#f4afa1',reprovados]].map(([l,c,n])=>`
          <div style="flex:1;min-width:100px;background:#f8fafc;border-radius:10px;padding:14px;text-align:center;border-top:3px solid ${c}">
            <div style="font-size:24px;font-weight:800;color:var(--navy)">${n}</div>
            <div style="font-size:10px;color:var(--muted);margin-top:3px">${l}</div>
            <div style="font-size:11px;font-weight:700;color:${c};margin-top:4px">${total?Math.round(n/total*100):0}%</div>
          </div>`).join('')}
      </div>
    </div>
    <div class="dash-box">
      <div class="dash-box-title">Candidatos por Vaga</div>
      ${vagasRank.map(([v,n])=>{const pct=Math.round(n/maxV*100);return`<div class="bar-row"><div class="bar-label" title="${v}">${v.slice(0,20)}</div><div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:var(--blue)"></div></div><div class="bar-val">${n}</div></div>`;}).join('')||'<div class="empty">Sem dados</div>'}
    </div>
    <div class="dash-box">
      <div class="dash-box-title">Candidatos por Cidade</div>
      ${cidades.map(([c,n])=>{const pct=Math.round(n/maxC*100);return`<div class="bar-row"><div class="bar-label">${c}</div><div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:var(--green)"></div></div><div class="bar-val">${n}</div></div>`;}).join('')||'<div class="empty">Sem dados</div>'}
    </div>
  `;
}

// CANDIDATOS
function renderCandidatos() {
  const filtered = candidatos.filter(c => {
    const b = candBusca.toLowerCase();
    const matchB = !b || (c['Nome']||'').toLowerCase().includes(b) || (c['Telefone']||'').includes(b) || (c['Vaga de Interesse']||'').toLowerCase().includes(b);
    const matchC = !filtroClass || c['Classificação']===filtroClass;
    const matchI = !filtroInt || c['Status']==='Interessado';
    return matchB && matchC && matchI;
  });
  const grid = document.getElementById('cand-grid');
  if (!filtered.length) { grid.innerHTML = '<div class="empty">Nenhum candidato encontrado.</div>'; return; }
  grid.innerHTML = filtered.map(c => {
    const cls = (c['Classificação']||'').toLowerCase();
    const score = Number(c['Score Geral']||c['Score da Vaga']||0);
    const nome = c['Nome']||'—';
    const tel = (c['Telefone']||'').replace(/\D/g,'');
    const clsKey = ['excelente','bom','regular','reprovado'].includes(cls)?cls:'default';
    const scoreCls = score>=80?'sc-alto':score>=60?'sc-medio':score>0?'sc-baixo':'sc-zero';
    const clsBadge = `cls-${clsKey}`;
    const statusChip = (()=>{const s=(c['Status']||'').toLowerCase();if(s.includes('interessado'))return`<span class="cc cc-green">✓ Interessado</span>`;if(s.includes('analisado'))return`<span class="cc cc-blue">🤖 Lia</span>`;if(s.includes('reprovado'))return`<span class="cc cc-red">✗ Reprovado</span>`;return c['Status']?`<span class="cc cc-gray">${c['Status']}</span>`:''})();
    const chips = [];
    if(c['Transporte Próprio']==='Sim')chips.push(`<span class="cc cc-navy">🚗</span>`);
    if(c['CLT Imediato']==='Sim')chips.push(`<span class="cc cc-navy">📄 CLT</span>`);
    if(c['Currículo']==='Sim')chips.push(`<span class="cc cc-green">📎</span>`);
    return `<div class="cand-card">
      <div class="card-top ${clsKey}">
        <div class="cav ${clsKey}">${nome.charAt(0).toUpperCase()}</div>
        <div class="cand-hinfo">
          <div class="cand-name">${nome}</div>
          <div class="cand-sub">${c['Cidade / Estado']?`<span>📍 ${c['Cidade / Estado']}</span>`:''}<span class="cls-badge ${clsBadge}">${c['Classificação']||'—'}</span></div>
        </div>
        <div class="score-c ${scoreCls}">${score||'—'}</div>
      </div>
      <div class="card-body">
        ${c['Vaga de Interesse']?`<div class="vaga-tag">💼 ${c['Vaga de Interesse']}</div>`:''}
        <div class="cchips">${statusChip}${chips.join('')}</div>
        ${c['Pontos Fortes']?`<div class="pfortes">💡 ${c['Pontos Fortes'].slice(0,100)}${c['Pontos Fortes'].length>100?'…':''}</div>`:''}
        ${c['Pontos de Atenção']?`<div style="font-size:10px;color:#888">⚠️ ${c['Pontos de Atenção'].slice(0,80)}</div>`:''}
      </div>
      <div class="card-footer">
        <span class="card-date">${c['Criado em']||''}</span>
        <div class="card-actions">
          <button class="action-btn aprovar" onclick="abrirModal('${tel}','${nome.replace(/'/g,"\\'")}')">✏️ Status</button>
          ${tel?`<button class="action-btn wa" onclick="window.open('https://wa.me/${tel}','_blank')">💬</button>`:''}
        </div>
      </div>
    </div>`;
  }).join('');
}

function filtrarCandidatos(v){candBusca=v;renderCandidatos()}
function setFiltroClass(el,v){filtroClass=v;document.querySelectorAll('#page-candidatos .fchip').forEach(c=>c.classList.remove('active'));el.classList.add('active');renderCandidatos()}
function toggleFiltroInt(){filtroInt=!filtroInt;document.getElementById('fchip-int').classList.toggle('active',filtroInt);renderCandidatos()}

// MODAL STATUS
function abrirModal(tel,nome){
  modalTelefone=tel;
  document.getElementById('modal-title').textContent=`Atualizar: ${nome}`;
  document.getElementById('modal-status').value='';
  document.getElementById('modal-obs').value='';
  document.getElementById('modal').classList.add('show');
}
function fecharModal(){document.getElementById('modal').classList.remove('show');modalTelefone=null}
async function salvarStatus(){
  if(!modalTelefone)return;
  const status=document.getElementById('modal-status').value;
  const obs=document.getElementById('modal-obs').value;
  if(!status&&!obs){fecharModal();return}
  try{
    const r=await fetch(`${API_BASE}/sheets/candidatos/status`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({telefone:modalTelefone,status,observacao:obs})});
    const d=await r.json();
    if(d.ok||d.sucesso){mostrarToast('Candidato atualizado!','success');await carregarTudo();}
    else mostrarToast('Erro ao salvar','error');
  }catch(e){mostrarToast('Erro de conexão','error')}
  fecharModal();
}

// VAGAS
function renderVagas(){
  const b=vagaBusca.toLowerCase();
  const filtered=vagas.filter(v=>{
    const enc=['inativa','fechada','cancelada','encerrada'].includes((v.status||'').toLowerCase());
    if(filtroVagaTab==='ativas'&&enc)return false;
    if(filtroVagaTab==='encerradas'&&!enc)return false;
    return !b||(v.cargo||'').toLowerCase().includes(b)||(v.cliente||'').toLowerCase().includes(b)||(v.cidade||'').toLowerCase().includes(b);
  });
  const grid=document.getElementById('vagas-grid');
  if(!filtered.length){grid.innerHTML='<div class="empty">Nenhuma vaga encontrada.</div>';return}
  grid.innerHTML=filtered.map(v=>{
    const enc=['inativa','fechada','cancelada','encerrada'].includes((v.status||'').toLowerCase());
    return`<div class="vaga-card ${enc?'encerrada':''}">
      <div><div class="vaga-titulo">${v.cargo||'—'}</div><div class="vaga-cliente">${v.cliente||'—'}</div></div>
      <div class="vaga-rows">
        ${v.cidade?`<div class="vaga-row"><span class="vaga-icon">📍</span>${v.cidade}</div>`:''}
        ${v.salario?`<div class="vaga-row"><span class="vaga-icon">💰</span>${v.salario}</div>`:''}
        ${v.horario?`<div class="vaga-row"><span class="vaga-icon">🕐</span>${v.horario}</div>`:''}
        ${v.experienciaMinima?`<div class="vaga-row"><span class="vaga-icon">💼</span>${v.experienciaMinima}</div>`:''}
        ${v.escolaridade?`<div class="vaga-row"><span class="vaga-icon">🎓</span>${v.escolaridade}</div>`:''}
        ${v.requisitoObrigatorio?`<div class="vaga-row"><span class="vaga-icon">⚠️</span><strong>${v.requisitoObrigatorio}</strong></div>`:''}
      </div>
      <div class="vaga-footer">
        <span class="cc ${enc?'cc-red':'cc-green'}">${v.status||'Aberta'}</span>
        ${v.aceitaSemExperiencia==='Sim'?'<span class="cc cc-blue">Aceita sem exp.</span>':''}
        ${v.exigeFimDeSemana==='Sim'?'<span class="cc cc-yellow">Fim de semana</span>':''}
        ${v.idVaga?`<span class="cc cc-gray">#${v.idVaga}</span>`:''}
      </div>
    </div>`;
  }).join('');
}
function filtrarVagas(v){vagaBusca=v;renderVagas()}
function setFiltroVaga(el,tab){filtroVagaTab=tab;document.querySelectorAll('#page-vagas .fchip').forEach(c=>c.classList.remove('active'));el.classList.add('active');renderVagas()}

// INBOX
function renderInboxLista(){
  const lista=document.getElementById('inbox-list');
  const entries=Object.entries(sessoes).filter(([tel,s])=>{
    const matchB=!inboxBusca||(s.nome||'').toLowerCase().includes(inboxBusca.toLowerCase())||tel.includes(inboxBusca);
    const matchTab=inboxTab==='todas'||(inboxTab==='manual'&&s.modo==='manual')||(inboxTab==='pausado'&&s.pausado===true);
    return matchB&&matchTab;
  });
  document.getElementById('inbox-count').textContent=entries.length;
  if(!entries.length){lista.innerHTML='<div class="empty" style="padding:24px;font-size:11px">Nenhuma conversa</div>';return}
  lista.innerHTML=entries.map(([tel,s])=>{
    const hist=s.historico||[];
    const ultima=hist[hist.length-1];
    const nome=s.nome||`+${tel}`;
    const isManual=s.modo==='manual'||s.pausado===true;
    const isActive=sessaoAtual===tel;
    const chips=[];
    if(isManual)chips.push(`<span class="cc cc-pink">✍️</span>`);
    chips.push(`<span class="cc cc-gray">${hist.length}msgs</span>`);
    return`<div class="iconv ${isActive?'active':''} ${isManual&&!isActive?'manual':''}" onclick="abrirConversa('${tel}')">
      <div class="iav">${nome.charAt(0).toUpperCase()}</div>
      <div class="iconv-info">
        <div style="display:flex;align-items:center;gap:4px;justify-content:space-between">
          <div class="iconv-name">${nome}</div>
          <div class="idot ${isManual?'manual':'lia'}"></div>
        </div>
        <div class="iconv-preview">${ultima?String(ultima.content||'').slice(0,45):''}</div>
        <div class="iconv-chips">${chips.join('')}</div>
      </div>
    </div>`;
  }).join('');
}
function filtrarInbox(v){inboxBusca=v;renderInboxLista()}
function setInboxTab(el,tab){inboxTab=tab;document.querySelectorAll('.iftab').forEach(t=>t.classList.remove('active'));el.classList.add('active');renderInboxLista()}

function abrirConversa(tel){
  sessaoAtual=tel;
  const s=sessoes[tel];if(!s)return;
  document.getElementById('ichat-empty').style.display='none';
  const ca=document.getElementById('ichat-active');ca.style.display='flex';
  const nome=s.nome||`+${tel}`;
  document.getElementById('ichat-av').textContent=nome.charAt(0).toUpperCase();
  document.getElementById('ichat-name').textContent=nome;
  document.getElementById('ichat-meta').textContent=`+${tel} · ${(s.historico||[]).length} msgs`;
  aplicarModoVisual(s.modo==='manual'?'manual':'lia');
  renderMsgs(s);
  renderInboxLista();
}

function renderMsgs(s){
  const div=document.getElementById('ichat-msgs');
  div.innerHTML='';
  const hist=s?.historico||[];
  if(!hist.length){div.innerHTML='<div class="empty">Nenhuma mensagem ainda</div>';return}
  let ultimaData='';let ultimoRole=null;
  hist.forEach(msg=>{
    const isUser=msg.role==='user';
    const ts=msg.timestamp||'';
    const dataMsg=ts?ts.split(',')[0]:'';
    if(dataMsg&&dataMsg!==ultimaData){
      const sep=document.createElement('div');sep.className='date-sep';sep.innerHTML=`<span>${dataMsg||'Hoje'}</span>`;div.appendChild(sep);ultimaData=dataMsg;ultimoRole=null;
    }
    const g=document.createElement('div');g.className=`msg-group ${isUser?'candidato':'lia'}`;
    if(ultimoRole!==msg.role){const sn=document.createElement('div');sn.className='msg-sender';sn.textContent=isUser?(s.nome?.split(' ')[0]||'Candidato'):'🤖 Lia';g.appendChild(sn);}
    const b=document.createElement('div');b.className=`mbubble ${isUser?'candidato':'lia'}`;b.textContent=msg.content||'';g.appendChild(b);
    if(ts){const t=document.createElement('div');t.className='msg-time';t.textContent=ts.split(',')[1]?.trim()||'';g.appendChild(t);}
    div.appendChild(g);ultimoRole=msg.role;
  });
  div.scrollTop=div.scrollHeight;
}

function aplicarModoVisual(modo){
  document.getElementById('mbtn-lia').className='mbtn'+(modo==='lia'?' lia-on':'');
  document.getElementById('mbtn-manual').className='mbtn'+(modo==='manual'?' manual-on':'');
  document.getElementById('manual-warn').classList.toggle('show',modo==='manual');
  document.getElementById('ichat-txt').placeholder=modo==='lia'?'A Lia responde automaticamente...':'Digite sua mensagem (como Lia)...';
}

async function setModo(modo){
  if(!sessaoAtual)return;
  try{
    const r=await fetch(`${API_BASE}/inbox/pausar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({telefone:sessaoAtual,pausado:modo==='manual',modo})});
    const d=await r.json();
    if(d.ok){if(sessoes[sessaoAtual]){sessoes[sessaoAtual].modo=modo;sessoes[sessaoAtual].pausado=modo==='manual';}aplicarModoVisual(modo);renderInboxLista();mostrarToast(modo==='manual'?'✍️ Modo manual':'🤖 Lia reativada','success');}
  }catch(e){mostrarToast('Erro','error')}
}

async function enviarMsg(){
  if(!sessaoAtual)return;
  const input=document.getElementById('ichat-txt');
  const texto=input.value.trim();if(!texto)return;
  const btn=document.getElementById('isend');btn.disabled=true;btn.textContent='...';
  try{
    const r=await fetch(`${API_BASE}/inbox/enviar`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({telefone:sessaoAtual,mensagem:texto,modo:'manual'})});
    const d=await r.json();
    if(d.ok){input.value='';input.style.height='auto';mostrarToast('Enviado!','success');await carregarTudo();if(sessoes[sessaoAtual])renderMsgs(sessoes[sessaoAtual]);}
    else mostrarToast('Erro: '+(d.erro||''),'error');
  }catch(e){mostrarToast('Erro de conexão','error')}
  btn.disabled=false;btn.textContent='Enviar';
}

function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,100)+'px'}
function mostrarToast(msg,tipo){const t=document.getElementById('toast');t.textContent=msg;t.className=`toast show ${tipo||''}`;setTimeout(()=>t.className='toast',2500)}
</script>
